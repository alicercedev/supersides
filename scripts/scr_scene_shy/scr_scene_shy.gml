function scr_scene_shy() {
    return [
        { nome: "Nich", texto: "Bom dia, Shy!" },
        { nome: "Shy", texto: "Oi." },
        { nome: "Nich", texto: "Hoje eu tô querendo ver uns filmes, o que acha? Com bastante comida!" },
        { nome: "Shy", texto: "Pode até ser, só que eu tô sem nada na geladeira, a menos que você aceite morrer com água fervida." },
        { nome: "Nich", texto: "Água fervida?" },
        { nome: "Shy", texto: "Gelatina." },
        { nome: "Nich", texto: "Ah okay, eu posso ir ao mercado." },
        { nome: "Shy", texto: "Tá bom, eu espero aqui vai." }
    ];
}